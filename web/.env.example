# Site
NEXT_PUBLIC_SITE_URL=https://godrinkfree.com

# Supabase (server-only — never expose service role to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer service role; anon key works with insert-only RLS if set server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# Optional public URL (same as SUPABASE_URL) if you need client-side later
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Resend (optional — waitlist confirm email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Drink Free <hello@godrinkfree.com>

# Sentry (optional — error monitoring; no-op without DSN)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
